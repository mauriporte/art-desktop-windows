      { "section": "Cameras", "cols": 2, "tiles": [ { "camera": "camera.front_door", "name": "Front door", "capture": "" } ] },
      { "section": "Switches", "cols": 2, "tiles": [
        { "entity": "switch.living_room_lamp", "name": "Lamp" },
        { "entity": "sensor.outdoor_temperature", "name": "Outside" },
        { "entity": "button.doorbell_snapshot", "name": "Snapshot", "icon": "restart", "confirm": true } ] } ] },
    "Assistant": { "label": "Assistant", "talk": true, "sections": [] }
